# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (must have pgvector extension enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploy_chat

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# Create at https://github.com/settings/developers → OAuth Apps
# Set callback URL to: http://localhost:3000/auth/callback/github
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ── App environment ────────────────────────────────────────────────────────────
# 'development' (default) allows localhost CORS and a placeholder SECRET_KEY.
# Anything else is treated as production: SECRET_KEY must be set, and only
# FRONTEND_ORIGINS may call the dashboard API.
ENVIRONMENT=development

# Comma-separated origins allowed to call the dashboard API.
# The embeddable widget is exempt — it must accept any customer domain.
FRONTEND_ORIGINS=https://app.example.com,https://example.com
